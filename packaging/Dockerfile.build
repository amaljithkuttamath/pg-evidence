# pg-evidence build environment: PostgreSQL 18 + pgvector + Rust + cargo-pgrx.
#
# Pins are recorded in packaging/versions.json after an observed build; see
# docs/build-environment.md. The base is a multi-arch index digest: build with
# --platform linux/arm64 for local development or linux/amd64 for the release
# target. An arm64 or emulated amd64 build does not prove native x86-64 (G1).
#
# Targets:
#   build-env      the toolchain image
#   probe-results  runs packaging/probe-steps.sh (G1/G2 probe) and exports only
#                  its logs, e.g. --target probe-results --output type=local,dest=DIR
# Cargo registries and target directories use tmpfs mounts, so they never
# persist in layers. Build context: repository root (see the .dockerignore file
# next to this Dockerfile).

ARG BASE_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie@sha256:9d9c930220cb9bf2f956d10a8f909cf9973d9672ca0278aef2c1e6facccad2e0
FROM ${BASE_IMAGE} AS build-env

ARG PG_MAJOR=18
ARG PG_DEV_VERSION=18.6-1.pgdg13+2
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256_AMD64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_SHA256_ARM64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
ARG RUST_TOOLCHAIN=1.99.0
ARG CARGO_PGRX_VERSION=0.19.3
ARG BUILD_JOBS=4

# postgresql-server-dev-18 already depends on clang-19 and llvm-19-dev.
# libclang1-19 provides the shared libclang that bindgen loads; the larger
# libclang-19-dev (static libraries) is not needed. cargo-pgrx builds
# openssl-sys, which needs pkg-config and libssl-dev. PostgreSQL 18 server
# headers include ICU (utils/pg_locale.h), so bindgen needs libicu-dev.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        "postgresql-server-dev-${PG_MAJOR}=${PG_DEV_VERSION}" \
        libclang1-19 gcc libc6-dev make pkg-config libssl-dev libicu-dev ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) triple=x86_64-unknown-linux-gnu; sum="$RUSTUP_SHA256_AMD64" ;; \
        arm64) triple=aarch64-unknown-linux-gnu; sum="$RUSTUP_SHA256_ARM64" ;; \
        *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${triple}/rustup-init"; \
    echo "${sum}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_TOOLCHAIN}" --default-host "${triple}"; \
    rm /tmp/rustup-init; \
    rm -rf /usr/local/rustup/downloads /usr/local/rustup/tmp; \
    rustc --version; cargo --version

# cargo-pgrx is compiled with the same toolchain; registry and target live in tmpfs.
RUN --mount=type=tmpfs,target=/tmp/cargo-build \
    set -eux; \
    CARGO_HOME=/tmp/cargo-build/home CARGO_TARGET_DIR=/tmp/cargo-build/target \
    cargo install --locked --jobs "${BUILD_JOBS}" --root /usr/local \
        cargo-pgrx --version "${CARGO_PGRX_VERSION}"; \
    cargo pgrx --version

# PostgreSQL refuses to run as root, so tests run as an unprivileged user that
# may install extension files into the system PostgreSQL directories.
RUN set -eux; \
    useradd --create-home --uid 1000 builder; \
    chown -R builder "$(pg_config --sharedir)/extension" "$(pg_config --pkglibdir)"

USER builder
ENV CARGO_HOME=/home/builder/.cargo PATH=/usr/local/cargo/bin:$PATH
RUN cargo pgrx init --pg${PG_MAJOR} "$(command -v pg_config)"
WORKDIR /home/builder

FROM build-env AS probe
ARG BUILD_JOBS=4
USER root
# Step failures are recorded in /out/probe-results.tsv, not hidden: the RUN
# itself succeeds so the logs can be exported.
RUN --mount=type=tmpfs,target=/work \
    --mount=type=bind,source=packaging/probe,target=/src/probe \
    --mount=type=bind,source=packaging/probe-steps.sh,target=/src/probe-steps.sh \
    --mount=type=bind,source=rust-toolchain.toml,target=/src/rust-toolchain.toml \
    mkdir -p /out && chown builder /work /out && \
    runuser -u builder -- env CARGO_BUILD_JOBS="${BUILD_JOBS}" bash /src/probe-steps.sh; \
    echo "probe-steps exit $?" >> /out/probe-results.tsv

FROM scratch AS probe-results
COPY --from=probe /out /

FROM build-env AS product
ARG PRODUCT_BUILD_JOBS=1
USER root
RUN --mount=type=tmpfs,target=/work \
    --mount=type=bind,source=.,target=/src/product \
    mkdir -p /out && chown builder /work /out && \
    runuser -u builder -- env CARGO_BUILD_JOBS="${PRODUCT_BUILD_JOBS}" bash /src/product/packaging/product-steps.sh; \
    echo "product-steps exit $?" > /out/build-exit.txt

FROM scratch AS product-results
COPY --from=product /out /
